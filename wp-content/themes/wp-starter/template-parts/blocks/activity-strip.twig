{% set items = fields.items ?? [
	{ label: 'Upcoming events', link: { url: '/news/' } },
	{ label: 'Reports', link: { url: '/resources/surveys-reports/' } },
	{ label: 'Working Groups', link: { url: '/eea-groups/' } },
	{ label: 'Member briefings', link: { url: '/news/' } },
	{ label: 'Newsletter', link: { url: 'https://eeamembershub.beehiiv.com/subscribe' } }
] %}

{% if items %}
	<div class="py-6 lg:py-8">
		<ul class="flex gap-3 overflow-x-auto no-scrollbar lg:flex-wrap lg:gap-4">
			{% for item in items %}
				{% if item.link %}
					<li class="shrink-0">
						<a href="{{ item.link.url }}" target="{{ item.link.target ?: '_self' }}"
							class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white no-underline transition-all border rounded-full whitespace-nowrap border-nav-border bg-[#141414] hover:opacity-80">
							{{ item.label ?: item.link.title }}
							<svg class="w-3 h-3" fill="none" viewBox="0 0 17 17" xmlns="http://www.w3.org/2000/svg">
								<path fill="currentColor" fill-rule="evenodd" d="M4.75.25H16a.75.75 0 0 1 .75.75v11.25a.75.75 0 0 1-1.5 0V2.81L1.53 16.53A.75.75 0 1 1 .47 15.47L14.19 1.75H4.75a.75.75 0 0 1 0-1.5Z" clip-rule="evenodd"/>
							</svg>
						</a>
					</li>
				{% endif %}
			{% endfor %}
		</ul>
	</div>
{% endif %}
